# ============================================
# InsurMatch Backend - Environment Variables Template
# Copy this file to .env and change credentials as needed
# ============================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insurmatch_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Secret & Expiration
JWT_SECRET=YourSuperSecretKeyForJWTTokenSigningMustBeAtLeast256BitsLong!!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Docker Compose Specific (for database container)
POSTGRES_DB=insurmatch_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
