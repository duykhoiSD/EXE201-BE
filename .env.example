# ============================================
# InsurMatch Backend - Environment Variables Template
# Copy this file to .env and change credentials as needed
# ============================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insurmatch_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Secret & Expiration
JWT_SECRET=YourSuperSecretKeyForJWTTokenSigningMustBeAtLeast256BitsLong!!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Docker Compose Specific (for database container)
POSTGRES_DB=insurmatch_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Mail Configuration (Gmail SMTP for OTP)
# Hướng dẫn lấy App Password Gmail:
#   1. Vào https://myaccount.google.com/security
#   2. Bật "Xác minh 2 bước" (2-Step Verification)
#   3. Vào mục "Mật khẩu ứng dụng" (App Passwords)
#   4. Tạo App Password cho "Mail" -> Copy mật khẩu 16 ký tự (không có khoảng trắng)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
